{
  "name": "ascii-art",
  "main": "server/index.js",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "aryamandarda.com",
      "custom_domain": true
    },
    {
      "pattern": "aryamandarda.com/ascii-art/nyc",
      "zone_name": "aryamandarda.com"
    },
    {
      "pattern": "aryamandarda.com/ascii-art/nyc/*",
      "zone_name": "aryamandarda.com"
    }
  ],
  "compatibility_date": "2026-11-08",
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/ascii-art/*",
      "/projects/ASCII/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ARTWORK_LIKES",
        "class_name": "ArtworkLikes"
      }
    ]
  },
  "migrations": [
    {
      "tag": "likes-v1",
      "new_sqlite_classes": [
        "ArtworkLikes"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
